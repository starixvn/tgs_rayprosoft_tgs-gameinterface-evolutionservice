<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Google.Protobuf" Version="3.21.2" />
	  <PackageReference Include="Grpc.Net.ClientFactory" Version="2.46.0" />
	  <PackageReference Include="Grpc.Tools" Version="2.46.3">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />
	  <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
  </ItemGroup>


  <ItemGroup>
    <Protobuf Include="..\Tgs.GameInterface.EvolutionService\Protos\gameinterfaceevoservice.proto" GrpcServices="Client">
      <Link>Protos\gameinterfaceevoservice.proto</Link>
    </Protobuf>
  </ItemGroup>


</Project>
